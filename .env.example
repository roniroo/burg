# Supabase project: burg (ybquniffzetaylkrkadz)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose to the browser. Bypasses RLS entirely.
# Needed by scripts/seed.ts, and at runtime by billing only: the Stripe webhook
# and the read-time resync write subscription rows that no signed-in user is
# allowed to write. Nothing else in the app reads it.
SUPABASE_SERVICE_ROLE_KEY=

# Not read by the app -- the callback uses request.nextUrl.origin and the
# sign-in form window.location.origin. Kept only because tooling expects it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Billing. Server-only. A sandbox is enough for development:
#   stripe sandbox create --from-git
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Locally, the secret printed by:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# In production, the endpoint's signing secret from the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
