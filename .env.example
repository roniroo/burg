# Burg needs no environment to run: `npm run dev` and Burg.app keep everything
# on this machine. Only `npm run import:hosted` reads these, to copy a city out
# of the hosted Supabase project it used to live in. It only ever reads.

NEXT_PUBLIC_SUPABASE_URL=
# Server-only. Bypasses RLS, which is why the import can see every row of one
# person's city. Never put it anywhere a browser can read it.
SUPABASE_SERVICE_ROLE_KEY=
